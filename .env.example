# Copy to .env and adjust. Never commit .env.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
# Retrieval: "hybrid" (BM25 keywords + embeddings, default), "similarity" (embeddings only) or "mmr"
RETRIEVAL_MODE=hybrid
# Rerank RERANK_CANDIDATES retrieved chunks with a cross-encoder and keep the best TOP_K
RERANK=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
# Candidate pool for MMR and for each ranking in hybrid search
MMR_FETCH_K=20
MMR_LAMBDA=0.5
MIN_RELEVANCE=0.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./chroma_db
COLLECTION_NAME=pdf_corpus
MAX_FILE_MB=50

# LLM provider: "ollama" (local, default) or "openai" (any OpenAI-compatible API)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.9
# Sampling top-k (LLM tokens; not the retrieval TOP_K above)
LLM_TOP_K=40
# Ollama context window in tokens (prompt + answer)
LLM_NUM_CTX=4096
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
